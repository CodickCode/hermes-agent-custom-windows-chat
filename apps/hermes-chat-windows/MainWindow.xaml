<Window x:Class="HermesChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HermesChat"
        Title="HermesChat — Виндовс-чат под Hermes агента"
        Height="840" Width="1280" MinHeight="600" MinWidth="1000"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Разделы -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TabChats" Content="Чаты" Tag="chats" Style="{StaticResource TabBtn}"
                        Click="OnTabClick" HorizontalAlignment="Left"/>
                <Button x:Name="TabProfiles" Content="Профили оркестраторов" Tag="profiles" Style="{StaticResource TabBtn}"
                        Click="OnTabClick" HorizontalAlignment="Left"/>
                <Button x:Name="TabGateways" Content="Внешние шлюзы" Tag="gateways" Style="{StaticResource TabBtn}"
                        Click="OnTabClick" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <local:ChatsTab x:Name="Chats" Visibility="Visible"/>
            <local:ProfilesTab x:Name="Profiles" Visibility="Collapsed"/>
            <local:GatewaysTab x:Name="Gateways" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>